<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <DebuggerType>NativeOnly</DebuggerType>
    <LocalDebuggerCommand>"@DEBUGGER_COMMAND@"</LocalDebuggerCommand>
    <LocalDebuggerCommandArguments>@DEBUGGER_ARGS@</LocalDebuggerCommandArguments>
    <LocalDebuggerWorkingDirectory>"@DEBUGGER_WORKDIR@"</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
</Project>