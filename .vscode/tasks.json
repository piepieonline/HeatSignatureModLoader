{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [ "--build", "--preset", "linux-debug" ],
      "windows": { "args": [ "--build", "--preset", "local-debug" ] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [ "$msCompile" ],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Build (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [ "--build", "--preset", "linux-release" ],
      "windows": { "args": [ "--build", "--preset", "local-release" ] },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [ "$msCompile" ],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Configure",
      "type": "shell",
      "command": "cmake",
      "args": [ "--preset", "linux-cross" ],
      "windows": { "args": [ "--preset", "x86-debug" ] },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
